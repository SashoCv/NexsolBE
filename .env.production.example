# Production env for api.nexsollabs.com (Hostinger). Copy to .env on the server and fill in.
# NEVER commit the real .env — only this template is committed.

APP_NAME="Nexsol Labs"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.nexsollabs.com
APP_KEY=                      # run on server: php artisan key:generate

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (create in Hostinger hPanel → Databases) ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions / security (HTTPS) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Frontend origin allowed to call the API (CORS) ---
FRONTEND_URL=https://www.nexsollabs.com

# --- Admin login user (used once by AdminUserSeeder) ---
ADMIN_NAME="Sasho Cvetanoski"
ADMIN_EMAIL=sasocvetanoski@nexsollabs.com
ADMIN_PASSWORD=                # set a strong password, then re-run the seeder

# --- Incoming mail (read-only inbox in admin) — optional ---
IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=sasocvetanoski@nexsollabs.com
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default

# Mail sending stays off unless you configure SMTP (form only stores to DB)
MAIL_MAILER=log
